# Production settings for docker-compose.prod.yml. Copy to .env, fill every value, then: chmod 600 .env
# Generate secrets with: openssl rand -hex 32   (ENCRYPTION_KEY: openssl rand -base64 32)

DOMAIN=book.jesspace.studio
ACME_EMAIL=admin@jesspace.studio
APP_URL=https://book.jesspace.studio
COOKIE_SECURE=true

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# first-run Owner/Staff accounts (used only on an empty database; change the passwords after the first login)
SEED_OWNER_EMAIL=owner@jesspace.studio
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=staff@jesspace.studio
SEED_STAFF_PASSWORD=

# Google Calendar OAuth client (Web application); the redirect URI must match exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://book.jesspace.studio/api/v1/integrations/google/callback

# backups: dump directory on the host (copied to Cloud Storage, see docs/DEPLOY_GCP.md)
BACKUP_DIR=/srv/jes/backups
BACKUP_RETENTION_DAYS=30
BACKUP_AT=02:30
