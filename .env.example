# least-privilege role used by the API and worker (created by the migrate job)
APP_DB_PASSWORD=change-me-too
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random
# 32 bytes base64: openssl rand -base64 32
ENCRYPTION_KEY=
APP_URL=http://localhost:8080
COOKIE_SECURE=false
SEED_OWNER_EMAIL=owner@jes.local
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=staff@jes.local
SEED_STAFF_PASSWORD=
# Google Calendar (OAuth client, type "Web application"); redirect URI must match exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google/callback
